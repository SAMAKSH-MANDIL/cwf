# Decentralized Verifiable AI Network Environment Configuration

# -------------------------------------------------------------
# Environment & Server
# -------------------------------------------------------------
ENV=development
API_PORT=8000
API_HOST=0.0.0.0
WEB_PORT=3000
SECRET_KEY=decentralized-ai-network-insecure-secret-key-32chars

# -------------------------------------------------------------
# Database & Cache
# -------------------------------------------------------------
# SQLite fallback is automatically used if PostgreSQL is not running
DATABASE_URL=sqlite:///./network_state.db
# DATABASE_URL=postgresql://user:password@localhost:5432/decentralized_ai
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# Storage
# -------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET_NAME=decentralized-ai-models
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
IPFS_GATEWAY=https://ipfs.io/ipfs/

# -------------------------------------------------------------
# Arbitrum (EVM Layer 2)
# -------------------------------------------------------------
ARBITRUM_RPC_URL=http://localhost:8545
ARBITRUM_CHAIN_ID=421614
ARBITRUM_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ARBITRUM_ZK_VERIFIER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ARBITRUM_MODEL_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ARBITRUM_CONTRIBUTION_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ARBITRUM_AI_PASSPORT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# -------------------------------------------------------------
# Solana (Compute & Incentives)
# -------------------------------------------------------------
SOLANA_RPC_URL=http://localhost:8899
SOLANA_NETWORK=devnet
SOLANA_PROGRAM_ID=Compute111111111111111111111111111111111111
SOLANA_RELAYER_KEYPAIR=

# -------------------------------------------------------------
# zkML Configuration
# -------------------------------------------------------------
ZKML_PROVER_MODE=deterministic
ZKML_CIRCUIT_PATH=./zkml/circuits
ZKML_SCALE_FACTOR=7
